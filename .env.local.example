# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/travel_dashboard?retryWrites=true&w=majority
MONGODB_URI=

# Google Maps API Key
# Requires Maps JavaScript API enabled in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional Google Map ID for Advanced Markers & Cloud Vector Styling (Optional)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
